# Required: encrypts stored passwords. Keep it secret and backed up;
# if it is lost, stored repeater/MQTT/ntfy passwords must be re-entered.
# Generate: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
MW_SECRET_KEY=

# Required: the public HTTPS origin you open meshwatch at (passkeys are bound to it).
MW_ORIGIN=https://meshwatch.example.org

# Optional
# MW_PUBLISH_PORT=8790
# MW_SETUP_TOKEN=   # fixed first-run setup token instead of a generated one
